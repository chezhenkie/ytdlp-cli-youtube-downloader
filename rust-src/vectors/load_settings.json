{
  "fn": "load_settings",
  "cases": [
    {"args": [{"path": "settings.json"}], "note": "missing file: defaults, no message, no notes"},
    {"args": [{"path": "settings.json", "seed_text": ""}], "note": "empty file is unreadable (JSONDecodeError)"},
    {"args": [{"path": "settings.json", "seed_text": "not json{"}], "note": "bad json is unreadable"},
    {"args": [{"path": "settings.json", "seed_hex": "efbbbf7b7d"}], "note": "UTF-8 BOM is unreadable like json.loads"},
    {"args": [{"path": "settings.json", "seed_hex": "7bbd7d"}], "note": "invalid UTF-8 bytes are unreadable"},
    {"args": [{"path": "settings.json", "seed_text": "42"}], "note": "number: for-key-in TypeError"},
    {"args": [{"path": "settings.json", "seed_text": "4.5"}], "note": "float: for-key-in TypeError"},
    {"args": [{"path": "settings.json", "seed_text": "true"}], "note": "bool: for-key-in TypeError"},
    {"args": [{"path": "settings.json", "seed_text": "null"}], "note": "null: for-key-in TypeError"},
    {"args": [{"path": "settings.json", "seed_text": "\"hello\""}], "note": "string without the type substring: .get AttributeError"},
    {"args": [{"path": "settings.json", "seed_text": "\"\""}], "note": "empty string: .get AttributeError"},
    {"args": [{"path": "settings.json", "seed_text": "\"type\""}], "note": "string containing type: substring short-circuit loads defaults"},
    {"args": [{"path": "settings.json", "seed_text": "\"printtype\""}], "note": "substring anywhere counts, same short-circuit"},
    {"args": [{"path": "settings.json", "seed_text": "[]"}], "note": "empty list: .get AttributeError"},
    {"args": [{"path": "settings.json", "seed_text": "[\"hello\", 1]"}], "note": "list without keys: .get AttributeError"},
    {"args": [{"path": "settings.json", "seed_text": "[\"output_dir\"]"}], "note": "list with a settings key: index TypeError"},
    {"args": [{"path": "settings.json", "seed_text": "[{}]"}], "note": "unhashable list element: TypeError"},
    {"args": [{"path": "settings.json", "seed_text": "{}"}], "note": "empty object loads defaults"},
    {"args": [{"path": "settings.json", "seed_text": "{\"video_resolution\": \"720\", \"zz\": 9, \"audio_only\": true}"}], "note": "known key merged, unknown dropped, legacy line fires"},
    {"args": [{"path": "settings.json", "seed_text": "{\"audio_only\": \"yes\"}"}], "note": "truthy string legacy value"},
    {"args": [{"path": "settings.json", "seed_text": "{\"audio_only\": false}"}], "note": "falsy legacy value stays video"},
    {"args": [{"path": "settings.json", "seed_text": "{\"type\": \"audio only\", \"audio_only\": true}"}], "note": "raw type present blocks the legacy line"},
    {"args": [{"path": "settings.json", "seed_text": "{\"playlist_max_items\": \"abc\", \"video_resolution\": \"not-a-number\", \"audio_quality\": \"banana\", \"video_container\": \"avi\", \"type\": \"tunnel\"}"}], "note": "junk coercion notes in python order"},
    {"args": [{"path": "settings.json", "seed_text": "{\"playlist_max_items\": \" 1_000 \"}"}], "note": "int() underscore-and-space form"},
    {"args": [{"path": "settings.json", "seed_text": "{\"playlist_max_items\": true}"}], "note": "bool is not a number: note"},
    {"args": [{"path": "settings.json", "seed_text": "{\"playlist_max_items\": 5.5}"}], "note": "float str() has a dot: note"},
    {"args": [{"path": "settings.json", "seed_text": "{\"audio_quality\": 5.0}"}], "note": "str(5.0) passes the quality pattern and lands as a string"},
    {"args": [{"path": "settings.json", "seed_text": "{\"audio_quality\": \"320K\"}"}], "note": "bitrate form keeps its case"},
    {"args": [{"path": "settings.json", "seed_text": "{\"audio_quality\": null}"}], "note": "null is not a quality value"},
    {"args": [{"path": "settings.json", "seed_text": "{\"settings_version\": 2.5, \"auto_update_last_check\": 1791925032.5, \"filename_template\": \"caf\u00e9 \u4e2d \ud83c\udf89\"}"}], "note": "floats and unicode survive to the render"},
    {"args": [{"path": "settings.json", "seed_text": "{\"auto_update_last_check\": NaN, \"settings_version\": Infinity, \"playlist_max_items\": -Infinity}"}], "note": "json constants: parse, render spellings, and the -inf coercion note"},
    {"args": [{"path": "settings.json", "seed_text": "{\"filename_template\": {\"a\": [1, [], {}]}}"}], "note": "structured junk value renders nested"},
    {"args": [{"path": "settings.json", "seed_text": "{\"video_resolution\": \"720\", \"video_resolution\": \"480\"}"}], "note": "duplicate keys: last wins"},
    {"args": [{"path": "settings.json", "seed_text": "{\"zz\": 99999999999999999999999999999999, \"audio_format\": \"wav\"}"}], "note": "bignum on an unknown key is dropped before it could matter"},
    {"args": [{"path": "settings.json", "seed_text": "{\r\n  \"audio_format\": \"wav\"\r\n}\r\n"}], "note": "CRLF file parses through the translation"},
    {"args": [{"path": "settings.json", "seed_text": "{\n  \"audio_format\": \"mp3\",\n  \"audio_quality\": \"0\",\n  \"auto_update\": true,\n  \"auto_update_last_check\": 1791925032,\n  \"ffmpeg_path\": \"\",\n  \"filename_template\": \"%(title)s\",\n  \"output_dir\": \"\",\n  \"playlist\": false,\n  \"playlist_max_items\": 0,\n  \"settings_version\": 1,\n  \"subtitle_langs\": \"en\",\n  \"subtitles\": true,\n  \"type\": \"video\",\n  \"video_container\": \"mp4\",\n  \"video_resolution\": \"1080\",\n  \"yt_dlp_path\": \"\"\n}\n"}], "note": "the tracked settings.json loads clean with no notes"}
  ]
}
