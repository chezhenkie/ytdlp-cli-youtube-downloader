{
  "fn": "http_text",
  "cases": [
    {
      "args": [
        {
          "url": "https://example.invalid/a"
        }
      ],
      "note": "plain body"
    },
    {
      "args": [
        {
          "url": "https://example.invalid/a",
          "timeout": 6
        }
      ],
      "note": "the 6 s non-forced ceiling is passed through"
    },
    {
      "args": [
        {
          "url": "https://example.invalid/a",
          "text": ""
        }
      ],
      "note": "empty body"
    },
    {
      "args": [
        {
          "url": "https://example.invalid/a",
          "text": "line\nline\n"
        }
      ],
      "note": "newlines survive"
    },
    {
      "args": [
        {
          "url": "https://example.invalid/a",
          "chunks": [
            "80",
            "78e9"
          ]
        }
      ],
      "note": "undecodable bytes become U+FFFD like python's replace"
    },
    {
      "args": [
        {
          "url": "https://example.invalid/a",
          "text": "404 page",
          "open_error": "boom"
        }
      ],
      "note": "urlopen raises: the error text is the seam's text"
    },
    {
      "args": [
        {
          "url": "https://example.invalid/a",
          "error": "gone"
        }
      ],
      "note": "a failure mid-read cannot happen for text, but the shape is pinned"
    }
  ]
}
