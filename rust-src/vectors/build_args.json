{
  "fn": "build_args",
  "cases": [
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "mp3", "audio_quality": "0"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "audio only with ffmpeg converts through -x"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "m4a", "audio_quality": "320K"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff", "which": {"node": "{scratch}/node"}}], "note": "node on PATH adds the runtime pair; which is called once"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "mp3", "audio_quality": "0"}, "url": "https://e.com/w?v=1"}], "note": "audio only without ffmpeg: single bestaudio stream"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "wav", "audio_quality": 5}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "non-string quality renders through str()"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "opus", "audio_quality": null}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "null quality renders as None"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "mp3", "audio_quality": ["x"]}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "container quality renders via repr"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video no audio", "video_resolution": "1080"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "video no audio keeps bv* with the height cap and no merge flag"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video no audio", "video_resolution": "best"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "resolution best drops the cap"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video no audio", "video_resolution": "720"}, "url": "https://e.com/w?v=1"}], "note": "video no audio without ffmpeg keeps the same selector"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "video with ffmpeg merges ba and formats mp4"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "best"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "container best skips the merge flag"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": ""}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "empty container skips the merge flag"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "best", "video_container": "best"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "bare bv* selector for best"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": 720, "video_container": "mkv"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "non-string resolution renders through %s"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out"}, "url": "https://e.com/w?v=1"}], "note": "missing type falls back to video; no ffmpeg means -f b"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "tunnel", "video_resolution": "1080", "video_container": "webm"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "unknown type behaves as the video branch"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": 5}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "capped playlist adds --playlist-items"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": 0}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "uncapped playlist adds neither flag"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": "3"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "string max parses through int()"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": " 1_0 "}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "int() tolerates underscores and whitespace"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": "abc"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "non-numeric string is the ValueError shape"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "absent max reads as 0: uncapped"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": null}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "null max reads as 0"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": -2}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "negative max adds neither flag"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4", "playlist": true, "playlist_max_items": true}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "true max int()s to 1"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "playlist": false}, "url": "https://e.com/w?v=1"}], "note": "playlist false adds --no-playlist"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out"}, "url": "https://e.com/w?v=1"}], "note": "absent playlist adds --no-playlist"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "playlist": 0}, "url": "https://e.com/w?v=1"}], "note": "zero playlist is falsy"},
    {"args": [{"s": {"filename_template": "/abs/%(title)s", "output_dir": "out", "type": "video", "video_resolution": "1080", "video_container": "mp4"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "absolute template drops -P but keeps every other flag"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": 5, "type": "video", "video_resolution": "1080", "video_container": "mp4"}, "url": "https://e.com/w?v=1"}], "note": "junk output_dir upstream is the AttributeError shape"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "video", "video_resolution": 1.5, "video_container": "best"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "float resolution renders through %s"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "type": "audio only", "audio_format": "best", "audio_quality": "0"}, "url": "https://live.example.org/room?a=1&b=2", "ffdir": "{scratch}/live dir"}], "note": "url and ffmpeg dir with query and space stay verbatim"}
  ]
}
