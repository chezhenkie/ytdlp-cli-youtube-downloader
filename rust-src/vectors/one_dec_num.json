    {"args": ["12.345"], "note": "no unit tail: no match"},
    {"args": [".5GB"], "note": "no integer part: no match"},
    {"args": ["3.14159MB"], "note": "pi"},
    {"args": ["0.999999GB"], "note": "zero integer part"},
    {"args": ["12.0%"], "note": "already one decimal"},
    {"args": ["9.9999KiB"], "note": "trailing digits"},
    {"args": ["-3.5MB"], "note": "minus sign is not in the pattern"},
    {"args": ["07.77MiB"], "note": "leading zero kept"},
