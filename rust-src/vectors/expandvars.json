{
  "fn": "expandvars",
  "cases": [
    {"args": [{"text": "$A", "env": {"A": "1", "B": "two words", "EMPTY": "", "AB": "ab", "ab": "low"}}]},
    {"args": [{"text": "${A}", "env": {"A": "1", "AB": "ab", "ab": "low"}}]},
    {"args": [{"text": "$A-x", "env": {"A": "1", "A-x": "dashed"}}], "note": "posix stops at the dash, windows name carries it"},
    {"args": [{"text": "$", "env": {}}]},
    {"args": [{"text": "$$", "env": {"A": "1"}}], "note": "windows collapses, posix keeps"},
    {"args": [{"text": "$A$B", "env": {"A": "1", "B": "two words"}}]},
    {"args": [{"text": "%A%", "env": {"A": "1"}}], "note": "windows percent form"},
    {"args": [{"text": "%%", "env": {"A": "1"}}]},
    {"args": [{"text": "100%", "env": {"A": "1"}}]},
    {"args": [{"text": "%A", "env": {"A": "1"}}]},
    {"args": [{"text": "%A%x", "env": {"A": "1"}}]},
    {"args": [{"text": "'$A'", "env": {"A": "1"}}], "note": "windows skips quoted chunks"},
    {"args": [{"text": "'%A%'", "env": {"A": "1"}}]},
    {"args": [{"text": "$MISSING", "env": {"A": "1"}}]},
    {"args": [{"text": "%MISSING%", "env": {"A": "1"}}]},
    {"args": [{"text": "${A", "env": {"A": "1"}}]},
    {"args": [{"text": "${}", "env": {"A": "1"}}]},
    {"args": [{"text": "${A}}", "env": {"A": "1"}}]},
    {"args": [{"text": "$A%%B", "env": {"A": "1", "B": "b"}}]},
    {"args": [{"text": "caf\u00e9$A", "env": {"A": "1"}}]},
    {"args": [{"text": "$$A", "env": {"A": "1"}}]},
    {"args": [{"text": "dollar$", "env": {}}]},
    {"args": [{"text": "$EMPTY.", "env": {"EMPTY": ""}}]},
    {"args": [{"text": "${EMPTY}x", "env": {"EMPTY": ""}}]},
    {"args": [{"text": "%EMPTY%.", "env": {"EMPTY": ""}}]},
    {"args": [{"text": "$ab", "env": {"AB": "ab", "ab": "low"}}], "note": "windows lookup is case-insensitive"},
    {"args": [{"text": "$AB", "env": {"AB": "ab", "ab": "low"}}]},
    {"args": [{"text": "%ab%", "env": {"AB": "ab", "ab": "low"}}]},
    {"args": [{"text": "$A$", "env": {"A": "1"}}]},
    {"args": [{"text": "\\$A", "env": {"A": "1"}}]},
    {"args": [{"text": "$A\\B", "env": {"A": "1", "B": "b"}}]},
    {"args": [{"text": "${a b}", "env": {"a b": "spaced"}}], "note": "brace form takes any non-brace run"},
    {"args": [{"text": "$1", "env": {"1": "digit"}}]},
    {"args": [{"text": "$_", "env": {"_": "under"}}]},
    {"args": [{"text": "$A.B", "env": {"A": "1"}}]},
    {"args": [{"text": "%A%$B", "env": {"A": "1", "B": "2"}}], "note": "both spellings in one pass"}
  ]
}
