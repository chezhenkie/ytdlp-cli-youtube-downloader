{
  "fn": "build_sub_args",
  "cases": [
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "base pass: srt conversion with ffmpeg"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff", "which": {"node": "{scratch}/node"}}], "note": "node on PATH appends the runtime pair at the end"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en"}, "url": "https://e.com/w?v=1"}], "note": "no ffmpeg converts to vtt in place"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en,nl"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "two codes join their patterns"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en, nl"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "entries are trimmed"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": ""}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "empty langs falls back to the en pattern"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": null}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "null langs falls back"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": 5}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "non-string langs renders through str()"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": true}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "true renders as True"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": 2.5}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "float renders through repr"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": ["en"]}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "hand-edited array renders as the python repr"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": [["a b"], {"k": "v"}]}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "nested container repr with its inner commas split and rejoined"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": ["a'b", "c\\d"]}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "repr quote choice and backslash escapes"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en-.*"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "pattern-ish code still gets the suffix"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "en,[unclosed"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "wildcard entries pass through unmodified"},
    {"args": [{"s": {"filename_template": "/abs/%(title)s", "output_dir": "out", "subtitle_langs": "en"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "absolute template drops -P here too"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": 5, "subtitle_langs": "en"}, "url": "https://e.com/w?v=1", "ffdir": "{scratch}/ff"}], "note": "junk output_dir is the AttributeError shape"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "", "subtitle_langs": "en"}, "url": "https://e.com/w?v=1", "auto": "{scratch}/auto"}], "note": "auto answer fills the -P pair"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "out", "subtitle_langs": "zh-Hant"}, "url": "https://e.com/w?v=1"}], "note": "region subtag keeps its own pattern"}
  ]
}
