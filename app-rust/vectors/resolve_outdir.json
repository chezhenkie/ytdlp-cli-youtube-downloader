{
  "fn": "resolve_outdir",
  "cases": [
    {"args": [{"output_dir": "rel"}], "note": "relative joins the root"},
    {"args": [{"output_dir": "{scratch}/abs2"}], "note": "absolute saved folder"},
    {"args": [{"output_dir": "/abs/x"}], "note": "posix absolute form"},
    {"args": [{"output_dir": "", "auto": "{scratch}/auto"}], "note": "empty uses the auto answer"},
    {"args": [{"output_dir": "   ", "auto": "{scratch}/auto"}], "note": "strip makes it empty"},
    {"args": [{"auto": "{scratch}/auto"}], "note": "absent key uses the auto answer"},
    {"args": [{"output_dir": null, "auto": "{scratch}/auto"}], "note": "null uses the auto answer"},
    {"args": [{"output_dir": 0, "auto": "{scratch}/auto"}], "note": "falsy junk uses the auto answer"},
    {"args": [{"output_dir": false, "auto": "{scratch}/auto"}], "note": "false is falsy"},
    {"args": [{"output_dir": [], "auto": "{scratch}/auto"}], "note": "empty list is falsy"},
    {"args": [{"output_dir": 5}], "note": "truthy non-string is the AttributeError shape"},
    {"args": [{"output_dir": true}], "note": "true is truthy and has no strip"},
    {"args": [{"output_dir": [1]}], "note": "non-empty list has no strip"},
    {"args": [{"output_dir": {"a": 1}}], "note": "non-empty dict has no strip"},
    {"args": [{"output_dir": "a//b"}], "note": "lexical render collapses separators"},
    {"args": [{"output_dir": "sub/../x"}], "note": "dotdot is kept"},
    {"args": [{"output_dir": "$HOME/x"}], "note": "no expansion in output_dir"},
    {"args": [{"output_dir": "."}], "note": "dot renders as the root"},
    {"args": [{"output_dir": "sub\\x"}], "note": "backslash kept on posix, folded on windows"},
    {"args": [{"output_dir": "trail/"}], "note": "trailing separator dropped"},
    {"args": [{"output_dir": "", "auto": null}], "note": "no auto answer: downloads fallback"},
    {"args": [{"output_dir": "caf\u00e9 dir"}], "note": "unicode folder"},
    {"args": [{"output_dir": "C:\\x"}], "note": "windows-shaped absolute string"}
  ]
}
