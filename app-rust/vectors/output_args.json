{
  "fn": "output_args",
  "cases": [
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "rel"}}], "note": "relative output_dir: root-joined -P pair"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": ""}, "auto": "{scratch}/auto"}], "note": "empty output_dir uses the auto answer"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": ""}}], "note": "no auto answer: downloads under the root"},
    {"args": [{"s": {"filename_template": "/abs/%(title)s", "output_dir": "rel"}}], "note": "posix absolute template skips both -P entries"},
    {"args": [{"s": {"filename_template": "C:/tpl", "output_dir": "rel"}}], "note": "drive + forward slash matches ABS_RE"},
    {"args": [{"s": {"filename_template": "C:\\tpl", "output_dir": "rel"}}], "note": "drive + backslash matches ABS_RE"},
    {"args": [{"s": {"filename_template": "\\tpl", "output_dir": "rel"}}], "note": "leading backslash matches ABS_RE on every os"},
    {"args": [{"s": {"filename_template": "C:tpl", "output_dir": "rel"}}], "note": "drive-relative does not match ABS_RE"},
    {"args": [{"s": {"filename_template": "sub/%(title)s", "output_dir": "rel"}}], "note": "relative template with separator keeps -P"},
    {"args": [{"s": {"filename_template": "", "output_dir": "rel"}}], "note": "empty template uses the shipped default"},
    {"args": [{"s": {"filename_template": null, "output_dir": "rel"}}], "note": "null template uses the default"},
    {"args": [{"s": {"filename_template": false, "output_dir": "rel"}}], "note": "false is falsy"},
    {"args": [{"s": {"filename_template": 0, "output_dir": "rel"}}], "note": "zero is falsy"},
    {"args": [{"s": {"filename_template": [], "output_dir": "rel"}}], "note": "empty list is falsy"},
    {"args": [{"s": {"filename_template": {}, "output_dir": "rel"}}], "note": "empty dict is falsy"},
    {"args": [{"s": {"filename_template": 5, "output_dir": "rel"}}], "note": "truthy non-string template is ABS_RE.match TypeError"},
    {"args": [{"s": {"filename_template": true, "output_dir": "rel"}}], "note": "true is truthy and not a string"},
    {"args": [{"s": {"filename_template": ["x"], "output_dir": "rel"}}], "note": "truthy list template is a TypeError"},
    {"args": [{"s": {"filename_template": {"a": 1}, "output_dir": "rel"}}], "note": "truthy dict template is a TypeError"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": 5}}], "note": "truthy non-string output_dir is the AttributeError shape"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": true}}], "note": "true is truthy and has no strip"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "/abs/out"}}], "note": "absolute output_dir stays as-is"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "a//b"}}], "note": "lexical render collapses separators"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "sub/../x"}}], "note": "dotdot is kept"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "caf\u00e9 dir"}}], "note": "unicode folder"},
    {"args": [{"s": {"filename_template": "%(title)s caf\u00e9", "output_dir": "rel"}}], "note": "unicode template"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "   "}, "auto": "{scratch}/auto"}], "note": "whitespace strip makes it empty: auto answer"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": "rel"}, "auto": "{scratch}/auto"}], "note": "set output_dir ignores the auto answer"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": null}}], "note": "null output_dir uses the auto path (none here)"},
    {"args": [{"s": {"filename_template": "%(title)s", "output_dir": []}}], "note": "empty list output_dir is falsy"}
  ]
}
