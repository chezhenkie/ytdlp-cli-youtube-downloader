    { "id": "check-update", "from": "auto_check", "to": "updater_cli", "variant": "dashed", "role": "branch", "route": "bottom-channel", "fromSide": "bottom", "toSide": "bottom" },
    { "id": "prompt-quick0", "from": "prompt", "to": "quick0", "role": "branch" },
    { "id": "prompt-url", "from": "prompt", "to": "dispatch", "label": "url", "variant": "emphasis", "role": "main" },
    { "id": "prompt-number", "from": "prompt", "to": "act", "label": "number", "role": "branch" },
    { "id": "quick0-url", "from": "quick0", "to": "dispatch", "label": "clipboard link", "role": "branch" },
    { "id": "dispatch-preflight", "from": "dispatch", "to": "preflight", "role": "main" },
    { "id": "preflight-run", "from": "preflight", "to": "run", "label": "ready", "variant": "emphasis", "role": "main" },
    { "id": "preflight-ffmpeg", "from": "preflight", "to": "ffmpeg_offer", "label": "no ffmpeg", "variant": "dashed", "role": "branch" },
    { "id": "ffmpeg-run", "from": "ffmpeg_offer", "to": "run", "role": "branch" },
    { "id": "run-subs", "from": "run", "to": "subs", "label": "rc 0", "role": "main" },
    { "id": "subs-finished", "from": "subs", "to": "finished", "role": "main" },
    { "id": "run-failed", "from": "run", "to": "failed", "label": "rc != 0", "variant": "security", "role": "error" },
    { "id": "run-escape", "from": "run", "to": "escape_stop", "label": "escape", "variant": "security", "role": "error" },
    { "id": "act-quit", "from": "act", "to": "quit", "role": "branch" },
    { "id": "act-settings", "from": "act", "to": "settings_write", "role": "branch" },
    { "id": "act-batch", "from": "act", "to": "batch", "label": "item 9", "role": "branch" },
    { "id": "act-updater", "from": "act", "to": "updater_ytdlp", "label": "item 11", "role": "branch" },
    { "id": "batch-preflight", "from": "batch", "to": "preflight", "label": "each url in order", "role": "branch" },
    { "id": "updater-chain", "from": "updater_ytdlp", "to": "updater_cli", "label": "then cli", "role": "main" }
  ],
  "semanticChecks": {
    "allowedRoots": ["launch"],
    "allowedTerminals": ["quit", "failed", "escape_stop", "updater_cli", "settings_write", "finished"],
    "requiredPaths": [
      { "from": "prompt", "to": "finished" },
      { "from": "batch", "to": "run" }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "Menu Loop",
      "items": [
        "Every action and verdict repaints to the prompt - the menu never disappears",
        "Escape wipes results at the prompt, backs out of a submenu, stops a running download",
        "quit is the only path that ends the process"
      ]
    },
    {
      "dot": "emerald",
      "title": "Daily Download",
      "items": [
        "Paste a url and press enter - saved defaults drive the whole run",
        "One frozen preflight line, one live progress line, one frozen verdict per run",
        "Every run end force-removes the .ytdlp-tmp work folder"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety Rails",
      "items": [
        "Updates install only behind digest and selftest gates",
        "Escape kills the whole process tree and aborts the rest of a batch (rc 130)",
        "Missing binaries, failures and refused installs end in a readable line"
      ]
    }
  ]
}
