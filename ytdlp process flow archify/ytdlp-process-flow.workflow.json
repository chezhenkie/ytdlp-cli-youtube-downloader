    { "id": "batch", "lane": "app", "col": 3, "type": "messagebus", "label": "Item 9 Batch", "sublabel": "one url per line", "tag": "FR-12", "width": 120 },
    { "id": "settings_write", "lane": "store", "col": 2, "type": "database", "label": "settings.json", "sublabel": "atomic write per change", "width": 132 },
    { "id": "dispatch", "lane": "dl", "col": 2, "type": "backend", "label": "Url Dispatch", "sublabel": "clean_url + scheme gate", "width": 132 },
    { "id": "preflight", "lane": "dl", "col": 3, "type": "backend", "label": "Preflight", "sublabel": "yt-dlp + ffmpeg probe", "width": 132 },
    { "id": "run", "lane": "dl", "col": 4, "type": "backend", "label": "yt-dlp Run", "sublabel": "spinner + progress", "width": 120 },
    { "id": "subs", "lane": "dl", "col": 5, "type": "backend", "label": "Subtitle Pass", "sublabel": "best-effort srt", "width": 120 },
    { "id": "ffmpeg_offer", "lane": "exc", "col": 4, "type": "external", "label": "FFmpeg Offer", "sublabel": "digest-first install", "tag": "FR-14", "width": 132 },
    { "id": "failed", "lane": "exc", "col": 5, "type": "security", "label": "Run Failed", "sublabel": "rc + full error line", "width": 132 },
    { "id": "escape_stop", "lane": "exc", "col": 3, "type": "security", "label": "Escape Stop", "sublabel": "kill tree, clean parts", "tag": "FR-11", "width": 132 },
    { "id": "auto_check", "lane": "net", "col": 0, "type": "cloud", "label": "Auto-Update Check", "sublabel": "daily, tty only", "width": 132 },
    { "id": "updater_ytdlp", "lane": "net", "col": 3, "type": "cloud", "label": "yt-dlp -U", "sublabel": "pre + post probe", "width": 120 },
