{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "yt-dlp cli Process Flow",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      { "id": "daily-path", "label": "Paste a url to verdict", "focus": ["launch", "auto_check", "prompt", "dispatch", "preflight", "run", "subs", "finished"], "note": "The everyday path: start, paste a url, press enter, read the frozen verdict." },
      { "id": "quick-paste", "label": "Bare 0 quick paste", "focus": ["prompt", "quick0", "dispatch"], "note": "On a real tty a bare 0 reads the clipboard and starts the download at the keypress." },
      { "id": "menu-and-settings", "label": "Menu actions", "focus": ["act", "settings_write", "batch", "quit"], "note": "Change defaults, batch urls, or leave; every change persists at once." },
      { "id": "update-and-stops", "label": "Updates and stops", "focus": ["auto_check", "updater_ytdlp", "updater_cli", "ffmpeg_offer", "failed", "escape_stop"], "note": "Update paths and the places where a run asks consent or stops." }
    ]
  },
  "lanes": [
    { "id": "console", "label": "Console UI" },
    { "id": "dl", "label": "Download Run" },
    { "id": "app", "label": "Menu Actions" },
    { "id": "store", "label": "Settings Store" },
    { "id": "exc", "label": "Stops & Failure Paths", "variant": "exception" },
    { "id": "net", "label": "Update & Network" }
  ],
  "phases": [
    { "id": "intake", "label": "Open + input", "fromCol": 0, "toCol": 1 },
    { "id": "route", "label": "Route + download", "fromCol": 2, "toCol": 4, "variant": "emphasis" },
    { "id": "verdict", "label": "Verdict", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "stop_paths", "label": "Consent + stop", "lane": "exc", "fromCol": 3, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["launch", "auto_check", "prompt", "dispatch", "preflight", "run", "subs", "finished"],
  "nodes": [
    { "id": "launch", "lane": "console", "col": 0, "type": "frontend", "label": "Launch", "sublabel": "VT + menu paint", "width": 120 },
    { "id": "prompt", "lane": "console", "col": 1, "type": "frontend", "label": "Main Prompt", "sublabel": "url / number / 0", "width": 120 },
    { "id": "quit", "lane": "console", "col": 3, "type": "frontend", "label": "Quit", "sublabel": "save + settings path", "width": 132 },
    { "id": "finished", "lane": "console", "col": 5, "type": "frontend", "label": "Finished Verdict", "sublabel": "file name + size", "width": 132 },
    { "id": "quick0", "lane": "console", "col": 2, "type": "external", "label": "Quick Paste 0", "sublabel": "clipboard link", "tag": "FR-17", "width": 120 },
