  "cards": [
    {
      "dot": "cyan",
      "title": "Download contract (FR-7, FR-8)",
      "items": [
        "Escape is the only accepted input while yt-dlp runs; it kills the tree and returns rc 130",
        "yt-dlp argv is pinned by the 177-check --selftest; audio-only or missing ffmpeg degrade instead of failing",
        "Subtitles are a separate best-effort pass after a successful video download (rate-limited api must not block the video)"
      ]
    },
    {
      "dot": "rose",
      "title": "Updater contract (FR-13)",
      "items": [
        "Daily check: one call site at menu open, real tty only, throttled by an 86400 s stamp",
        "New cli binary: digest and version arrive in one GET, then <new> --selftest gates the rename-into-place",
        "No release publishes a bare cli image, so the self-update always resolves to the missing-asset refusal"
      ]
    },
    {
      "dot": "amber",
      "title": "Work folder rule (FR-11)",
      "items": [
        ".ytdlp-tmp inside the output folder holds fragments, .part files and resume markers",
        "Every run end force-removes it: success, failure, escape and Ctrl+C",
        "The output folder shows finished files only; the final move is a same-volume rename"
      ]
    }
  ]
